# Copy to .env for local runs. In GitHub Actions these come from repository secrets/variables.

CHANNEL_NAME=Вайб-радар

# --- AI (Google Gemini). Use a key from its OWN Google Cloud project:
# free-tier quotas are per project, sharing a key with the other channels halves everyone's quota.
GEMINI_API_KEY=
# Optional paid key (separate project with billing) — used only for scan/writing, hard daily cap below.
# GEMINI_PAID_API_KEY=
# PAID_DAILY_BUDGET_EUR=0.24
# LLM_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemma-4-31b-it
# LLM_EDITOR_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest,gemma-4-31b-it

# --- Telegram: bot from @BotFather, added to the channel as an admin with "Post messages"
# (and "Pin messages" for the daily digest).
TELEGRAM_BOT_TOKEN=
# @channelname or numeric id (-100…)
TELEGRAM_CHANNEL_ID=

# true = build everything, send nothing. Switch to false only after reading a day of output (npm run posts).
DRY_RUN=true

# --- GitHub token (optional locally; Actions provides one): raises Search/API limits.
# GITHUB_TOKEN=

# --- Editorial thresholds (defaults mirror the prompt)
# POST_THRESHOLD=7
# POST_MIN_PLATFORMS=2
# EARLY_POST_THRESHOLD=6
# DIGEST_THRESHOLD=4
# ANOMALY_STARS_24H=1000
# ANOMALY_HN_POINTS_24H=300
# ANOMALY_REDDIT_24H=800
# ANOMALY_HF_LIKES_24H=150
# UPDATE_GROWTH=3
# MAX_POSTS_PER_RUN=2
# MAX_POSTS_PER_DAY=6
# DIGEST_HOUR_LOCAL=21
# TIMEZONE=Europe/Helsinki
